# Supabase project settings -- from Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key -- server-only, bypasses Row Level Security. Never expose
# this to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public origin of this deployment, no trailing slash. Used for the Flutterwave
# payment redirect, password-reset links, canonical URLs, sitemap, and
# structured data. In development this falls back to http://localhost:3000
# when unset; in production, it's required -- the app refuses to boot
# without it rather than silently generating broken links.
# Production: https://hayven.com.ng
NEXT_PUBLIC_SITE_URL=

# Flutterwave (payments) -- from the Flutterwave dashboard. Use the TEST keys
# until you go live.
#
# FLUTTERWAVE_SECRET_KEY: Settings > API keys > Secret key. Used to start
# checkouts, verify payments, process refunds, check bank accounts and pay
# out therapist earnings. Without it, checkout and payouts are switched off
# with a clear message.
#
# FLUTTERWAVE_WEBHOOK_HASH: a long random string YOU choose, entered under
# Settings > Webhooks > "Secret hash". Flutterwave sends it back in the
# verif-hash header; webhooks without the exact value are rejected. Set the
# webhook URL to https://<your domain>/api/webhooks/flutterwave and enable
# webhooks for refunds and transfers too.
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# Resend (email delivery for notifications) -- API Keys in the Resend
# dashboard. Without this set, emails are silently skipped (in-app
# notifications still work).
RESEND_API_KEY=

# Optional -- defaults to Resend's sandbox address, which only delivers to
# your own Resend account email. Once a sending subdomain is verified in
# Resend, set this to a real address on it.
# Production: Hayven <notifications@send.hayven.com.ng>
EMAIL_FROM=

# Sentry (error monitoring). DSN from your Sentry project's settings --
# without it, error reporting is silently skipped. org/project slugs and
# SENTRY_AUTH_TOKEN are optional and only used for source map upload
# (prettier stack traces in the Sentry dashboard) -- error capture itself
# works without them.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Cloudmersive (virus scanning for therapist credential uploads) -- API key
# from your Cloudmersive dashboard. Unlike the integrations above, this
# fails CLOSED: without it set, credential uploads are rejected rather than
# let through unscanned.
CLOUDMERSIVE_API_KEY=

# Web Push (real OS-level notifications for parents) -- a VAPID keypair
# identifying this server to push services. Generate your own with
# `npx web-push generate-vapid-keys`; without these set, push subscribing
# silently no-ops (in-app + email notifications still work). The public key
# is safe to expose to the browser; the private key is not.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact URI push services may use to reach you about this key, e.g.
# "mailto:hayvenmind@gmail.com".
VAPID_SUBJECT=

# Video-call origin for virtual sessions. When set, a confirmed virtual
# booking gets a meeting link of `${MEETING_BASE_URL}/${bookingId}` and the
# parent is told to join from their sessions page. When unset, virtual
# bookings carry no auto link and the parent is told the therapist will
# share one directly. No default -- pick a tool first (Google Meet, Whereby,
# Jitsi, etc.).
MEETING_BASE_URL=

# PostHog (product analytics) -- Project API key from your PostHog project
# settings. EU Cloud region. Safe to expose (write-only ingest key). When
# unset, all analytics calls are silent no-ops and the /ingest reverse proxy
# in next.config.ts is not registered. Events carry only coarse, non-
# identifying data (role, funnel step, counts, naira amounts) -- never a
# child's name, DOB, presenting concern, session notes, or report text.
NEXT_PUBLIC_POSTHOG_KEY=
# Optional -- server-side ingest host. Defaults to https://eu.i.posthog.com
# (EU Cloud). Only change this for a self-hosted PostHog instance.
POSTHOG_HOST=

# Google Analytics 4 -- Measurement ID from admin.google.com/analytics
# (Admin -> Data Streams -> your web stream), starts with "G-". Separate from
# PostHog: this exists specifically because Google Search Console, Google
# Ads, and most SEO tooling expect a GA4 property to link to. When unset, no
# GA script loads and the CSP stays tighter (no googletagmanager.com /
# google-analytics.com allowance).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console site-ownership verification -- from Search Console ->
# Settings -> Ownership verification -> HTML tag method -> the "content"
# attribute value only (not the whole <meta> tag). When unset, no
# verification meta tag is rendered.
GOOGLE_SITE_VERIFICATION=

# Shared secret the /api/cron/notifications route checks against the
# `Authorization: Bearer` header on every request -- without it set, the
# cron endpoint rejects all requests rather than running unauthenticated.
# Vercel Cron sends this header automatically when CRON_SECRET is set as a
# project env var; an external pinger (GitHub Actions, cron-job.org, etc.)
# needs it configured to send the same header.
CRON_SECRET=

# Signing key for the one-click email-unsubscribe link's tamper-proof token.
# Generate a random value, e.g. `openssl rand -hex 32`. Without this set,
# unsubscribe tokens fall back to signing with SUPABASE_SERVICE_ROLE_KEY (a
# cross-trust-boundary key reuse this var exists to avoid) and a warning is
# logged once at runtime -- set this before launch.
UNSUBSCRIBE_SECRET=
